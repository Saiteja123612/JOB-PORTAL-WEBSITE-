PORT=3000
# Local default is loopback; production defaults to 0.0.0.0 for cloud hosting.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Use 1 on Render; use 0 when accessing Node directly.
TRUST_PROXY_HOPS=0
NODE_ENV=development
# Required in production: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DATABASE_PATH=./data/portal.sqlite
# Enable only locally to populate sample job listings.
SEED_DEMO=true
# Share this spreadsheet with the service account as Editor. Create a Signups tab.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Signups
GOOGLE_APPLICATION_CREDENTIALS=
# Production webhook URL; configure Header Auth using X-Webhook-Secret in n8n.
N8N_CHAT_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
